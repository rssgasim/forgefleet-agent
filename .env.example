# ForgeFleet Cloud API Configuration
FORGEFLEET_API_URL=https://api.forgefleet.example.com
FORGEFLEET_AGENT_TOKEN=your_agent_token_here

# Agent Configuration
AGENT_NAME=ForgeFleet Agent
AGENT_VERSION=1.0.0
LOG_LEVEL=INFO

# Printer Discovery Configuration
DISCOVERY_TIMEOUT_SECONDS=5
DISCOVERY_INTERVAL_SECONDS=3600
DISCOVERY_ENABLED=true

# Telemetry Collection
TELEMETRY_INTERVAL_SECONDS=5
TELEMETRY_BATCH_SIZE=10
TELEMETRY_ENABLED=true

# Cloud Connection
CLOUD_HEARTBEAT_INTERVAL_SECONDS=30
CLOUD_RECONNECT_MAX_RETRIES=10
CLOUD_RECONNECT_BACKOFF_INITIAL_SECONDS=2
CLOUD_RECONNECT_BACKOFF_MAX_SECONDS=300

# Database
DATABASE_PATH=C:\ProgramData\ForgeFleet\agent.db
DATABASE_BACKUP_ENABLED=true

# Logging
LOG_PATH=C:\ProgramData\ForgeFleet\logs
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=5
LOG_FORMAT=structured

# Local UI
LOCAL_UI_ENABLED=true
LOCAL_UI_HOST=localhost
LOCAL_UI_PORT=9090
LOCAL_UI_SECURE=false

# Workspace
WORKSPACE_ID=workspace_default

# Advanced
DEBUG_MODE=false
VERIFY_SSL=true
